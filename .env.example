# Server Configuration
NODE_ENV=development
PORT=5000

# Google Gemini AI API Keys (supports up to 3 keys with automatic fallback)
# If one key hits its quota or fails, the server will try the next one automatically.
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
# GEMINI_API_KEY is still supported as a legacy single-key fallback

# Pixabay API Key
# Get your key from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Database Configuration
DATABASE_URL=your_database_connection_string_here

# Buy Me a Coffee Payments
BMC_USERNAME=your_buy_me_a_coffee_username
BMC_WEBHOOK_SECRET=your_bmc_webhook_secret

# Contact Form
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Admin Role Configuration
# Comma-separated emails. Server value controls protected admin APIs.
ADMIN_EMAILS=admin@example.com
VITE_ADMIN_EMAILS=admin@example.com
VITE_DEVELOPER_EMAILS=developer@example.com

# Firebase Configuration (Client-side - must be prefixed with VITE_)
# Get these from: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Admin SDK (server only)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project_id"}
